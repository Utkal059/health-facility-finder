# Copy to .env for local work. Never commit the real .env.

# Postgres used by the migrations, the scraper and the API.
# Matches the database docker compose starts on localhost:5432.
DATABASE_URL=postgresql://hff:hff@localhost:5432/hff

# Only used by the integration tests; they wipe this database.
TEST_DATABASE_URL=postgresql://hff:hff@localhost:5432/hff_test

# API
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
RATE_LIMIT_PER_MINUTE=60
# Set to true behind a proxy (Render, Fly) so rate limits use X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Scraper. The contact goes into the User-Agent so NHPR can reach whoever runs it.
SCRAPER_CONTACT=your-email@example.com
SCRAPER_MIN_DELAY_SECONDS=4
SCRAPER_CAPTCHA_TIMEOUT_SECONDS=300

# Frontend: Vite reads this at build time from frontend/.env.local or the build
# environment (Vercel, Docker build arg). Defaults to http://localhost:8000.
VITE_API_BASE_URL=http://localhost:8000
